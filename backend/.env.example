# PostgreSQL Database Connection URL (e.g. Neon, Supabase, Local PG)
# Example: postgresql://username:password@localhost:5432/hotel_db?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hotel_db?schema=public"

# JSON Web Token Secret Key
JWT_SECRET="generate_a_secure_random_hash_for_production"

# Express API Port
PORT=5000

# Client Frontend Host URL (for CORS allowance)
FRONTEND_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"
